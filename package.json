{
	"name": "mq_decrafting_table",
	"version": "1.1.0",
	"description": "Minecraft 基岩版附加包: 分解台, 支持将物品反向分解为合成材料",
	"type": "module",
	"author": "lxhzzy",
	"license": "MIT",
	"scripts": {
		"gen": "cargo run --release --manifest-path mq_decrating_table-rs/Cargo.toml && node scripts/gen-index.mjs",
		"gen:ui": "node experiment/build-ui.mjs --production",
		"gen:index": "node scripts/gen-index.mjs",
		"build": "gulp build",
		"deploy": "gulp -d",
		"watch": "gulp -w -d",
		"clean": "gulp -c",
		"check": "tsc --noEmit --strict --target es2020 --module esnext --moduleResolution bundler --skipLibCheck src/main.ts",
		"test": "node --test \"test/**/*.test.mjs\"",
		"test:pack": "node scripts/check-pack.mjs",
		"test:rust": "cargo test --manifest-path mq_decrating_table-rs/Cargo.toml",
		"verify": "npm run test:rust && npm run test && npm run test:pack"
	},
	"dependencies": {
		"@minecraft/server": "^2.10.0",
		"form-data": "^4.0.2"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@actions/exec": "^1.1.1",
		"@actions/github": "^6.0.0",
		"@actions/http-client": "^2.2.3",
		"@octokit/rest": "^21.0.2",
		"@types/libsodium-wrappers": "^0.7.14",
		"atomic-sleep": "^1.0.0",
		"axios": "^1.7.7",
		"compressing": "^1.10.1",
		"crypto": "^1.0.1",
		"del": "^7.1.0",
		"gulp": "^5.0.0",
		"gulp-zip": "^6.0.0",
		"langfc": "^1.3.1",
		"libsodium-wrappers": "^0.7.15",
		"minimist": "^1.2.8",
		"tsup": "^8.2.4",
		"typescript": "^5.5.4"
	}
}
